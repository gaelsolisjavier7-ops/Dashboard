{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/telegram.ts": { "maxDuration": 60, "memory": 512 },
    "api/ticket-scan.ts": { "maxDuration": 30, "memory": 512 }
  },
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }],
  "headers": [
    { "source": "/api/telegram", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}