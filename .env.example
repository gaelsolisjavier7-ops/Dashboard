# Configuración opcional de Firebase para producción
# Si no se definen, la app funciona de inmediato en modo local / demo con persistencia en el navegador
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:12345:web:abcdef12345

# ─────────────────────────────────────────────────────────────────────────────
# Bot de Telegram (Vercel Serverless Function · api/telegram.ts)
# Estas variables NO llevan prefijo VITE_: son sólo del servidor.
# ─────────────────────────────────────────────────────────────────────────────

# Token que te da @BotFather
TELEGRAM_BOT_TOKEN=

# Único chat atendido (tu Telegram user id)
TELEGRAM_CHAT_ID=6002544825

# Cadena aleatoria; Telegram la manda en el header X-Telegram-Bot-Api-Secret-Token
# Genérala con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=

# API key de Google AI Studio (Gemini)
GEMINI_API_KEY=

# Modelo de Gemini (opcional; por defecto gemini-2.0-flash)
GEMINI_MODEL=

# JSON COMPLETO del Service Account de Firebase (Firebase Console → Configuración
# del proyecto → Cuentas de servicio → Generar nueva clave privada).
# En UNA sola línea. También se acepta el JSON en base64.
FIREBASE_SERVICE_ACCOUNT_JSON=

# ---------------------------------------------------------------------------
# Escaner de tickets de compra (api/ticket-scan.ts)
# NO necesita variables nuevas: reutiliza GEMINI_API_KEY y
# FIREBASE_SERVICE_ACCOUNT_JSON de arriba (este ultimo para verificar el ID
# token de Firebase del usuario que sube la foto).
# Si GEMINI_MODEL esta definido, el escaner tambien lo usa; si no, usa
# 'gemini-flash-lite-latest' (el bot sigue usando su propio valor por defecto).
# ---------------------------------------------------------------------------
